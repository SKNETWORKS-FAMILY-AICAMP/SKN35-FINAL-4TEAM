# 로컬 개발 예시입니다. 사용자·암호·DB 이름을 바꾸면 DATABASE_URL도 맞추세요.
POSTGRES_USER=slotagent
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=slotagent
# Windows의 localhost 이름 해석 지연을 피하기 위해 IPv4를 명시합니다.
DATABASE_URL=postgresql://slotagent:local_dev_only@127.0.0.1:5432/slotagent

# 실제 키는 .env에만 넣고 커밋하지 않습니다.
OPENAI_API_KEY=

# 선택적 캐시. 작업 큐로 사용하지 않습니다.
REDIS_URL=redis://127.0.0.1:6379/0
