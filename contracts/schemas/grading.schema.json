{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slotagent.local/schemas/grading.schema.json",
  "title": "채점 칸들",
  "description": "grading_runs.judge_settings(②) · condition_results.evidence(①) · trial_metrics(①). 나머지 채점 결과(success, result_class, first_fail_type ...)는 DB 칸에 바로 들어감. condition_evidence 는 작은 조각이라 schema_version 이 없음 (DB 칸도 없음)",
  "$defs": {
    "judge_settings": {
      "description": "LLM 판정기 설정 (②가 정함). 읽는 곳: settings(scope=domain, key='judge.settings') 최신 행 → ①이 grading_runs 를 만들 때 그대로 복사. LLM 을 쓰지 않는 채점(규칙만)은 {} (judge_model 도 NULL)",
      "oneOf": [
        {
          "description": "빈 객체 = 해당 없음 (DB 기본값 '{}')",
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "temperature",
            "votes",
            "questions"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "votes": {
              "description": "같은 질문 몇 번 (엇갈리면 상위 모델 1번 더 = vote_no 4)",
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "tiebreak_model": {
              "type": "string"
            },
            "questions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/question_kind"
              }
            },
            "rubric_version": {
              "description": "기준표 버전 (3분류 기준표)",
              "type": "string"
            }
          }
        }
      ]
    },
    "condition_evidence": {
      "description": "조건 하나를 맞다/틀리다 한 근거 (①). 근거는 spans.id 가 아니라 seq 로 가리킴 — 골든 궤적(DB id 없음)에도 같은 채점 코드를 쓰기 위해. 시도는 trials.attempt 의 지금 시도",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_seqs"
      ],
      "properties": {
        "span_seqs": {
          "description": "근거가 된 spans.seq (같은 풀이·지금 시도 안). 없으면 [] (예: end_state='none' 통과)",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "found": {
          "description": "찾은 값 (정규화 뒤)",
          "type": [
            "string",
            "number",
            "array",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "trial_metrics": {
      "description": "진단 지표 (①). grader_error 행은 {} (DB CHECK 가 강제). [확장] 새 지표는 키 추가 → schema_version 올림",
      "oneOf": [
        {
          "description": "빈 객체 = 해당 없음 (DB 기본값 '{}')",
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "tool_calls"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 0
            },
            "distinct_tools": {
              "type": "integer",
              "minimum": 0
            },
            "repeated_calls": {
              "description": "같은 도구·같은 인자 다시 부름",
              "type": "integer",
              "minimum": 0
            },
            "empty_results": {
              "type": "integer",
              "minimum": 0
            },
            "steps": {
              "type": "integer",
              "minimum": 0
            },
            "tool_sec_by_tool": {
              "description": "도구별 시간 합 (리포트 상위 10개 표의 원본)",
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      ]
    }
  }
}
