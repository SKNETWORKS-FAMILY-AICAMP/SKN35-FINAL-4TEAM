{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slotagent.local/schemas/write_scenario.schema.json",
  "title": "문항별 가짜 쓰기·상태 시나리오 (tasks.write_scenario)",
  "description": "쓰는 역할 ② · 읽는 역할 ①(엔진 전용, 모델 입력에 넣지 않음). 이름표 + 대상 값으로 맞는 쓰기를 찾음. 2026-11-25 적용",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "writes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "target",
          "outcomes"
        ],
        "properties": {
          "capability": {
            "$ref": "common.schema.json#/$defs/capability"
          },
          "target": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcomes": {
            "description": "맞는 쓰기가 실행된 순서대로. 다 쓰면 마지막 값을 반복",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "ok",
                    "failed",
                    "unknown"
                  ]
                },
                "applied": {
                  "description": "unknown 만. 실제로 반영됐는지",
                  "type": "boolean"
                },
                "lookup": {
                  "description": "결과 조회로도 알 수 없음. 비우면 실제 반영 여부를 보여 줌",
                  "const": "unknown"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "description": "성공 응답·결과 조회에 보일 값",
                  "type": "object"
                }
              },
              "if": {
                "properties": {
                  "status": {
                    "const": "unknown"
                  }
                }
              },
              "then": {
                "required": [
                  "applied"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "applied"
                      ]
                    },
                    {
                      "required": [
                        "lookup"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "states": {
      "description": "승인 뒤 바뀌는 업무 상태. get_work_state 로만 보임",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "versions"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from_approvals",
                "value"
              ],
              "properties": {
                "from_approvals": {
                  "type": "integer",
                  "minimum": 0
                },
                "value": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
