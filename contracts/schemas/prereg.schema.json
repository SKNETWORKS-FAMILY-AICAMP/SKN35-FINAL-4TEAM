{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slotagent.local/schemas/prereg.schema.json",
  "title": "사전 등록 (experiments.prereg)",
  "description": "내용을 정하는 역할 ③ · 저장하는 역할 ④(초안) · 읽는 역할 ①(오류 처리)·③(판정). ④는 값을 직접 정하지 않고 POST /api/experiments/plan-proposal 이 돌려준 prereg 를 그대로 저장함 (기본값은 settings, 계산은 ③). 잠근 뒤 바꾸면 exploratory=true. outcome_rules·max_env_retries 가 없으면 DB가 잠금을 막음",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "primary_metric",
    "test",
    "margin_pp",
    "alpha",
    "outcome_rules",
    "max_env_retries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "primary_metric": {
      "const": "success_rate"
    },
    "test": {
      "description": "ni_then_sup = 비열등성 먼저, 통과하면 우월성까지 (판정 4종의 기본). 하나만 볼 때 noninferiority / superiority",
      "enum": [
        "ni_then_sup",
        "noninferiority",
        "superiority"
      ]
    },
    "margin_pp": {
      "description": "비열등성 마진 %p (기본값 settings ni_margin_pp, 기획서 1.2: 5)",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 50
    },
    "alpha": {
      "description": "유의수준. analyses.method.correction.alpha 는 이 값의 기록용 복사본 (저장할 때 같은지 확인: common.checks.check_method)",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.2
    },
    "secondary_metrics": {
      "description": "success_rate 는 1차 지표라 넣지 않음. 회귀율은 지표가 아니라 regression_limit 로 보고 comparisons.regression_rate 칸에 기록",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/metric"
          },
          {
            "not": {
              "const": "success_rate"
            }
          }
        ]
      }
    },
    "expected": {
      "description": "예상 방향 (사전에 적어 둠)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "better_label": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "diff_pp": {
          "type": "number"
        }
      }
    },
    "regression_limit": {
      "description": "회귀율 한도 (기본값 settings regression_limit, 기획서 1.2: 0.05)",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sequential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "none",
            "group_sequential"
          ]
        },
        "looks": {
          "description": "중간 분석 횟수 (마지막 포함). plan.tasks 의 가장 큰 batch_no 와 같아야 함 (common.checks.check_plan)",
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "if": {
        "properties": {
          "method": {
            "const": "group_sequential"
          }
        }
      },
      "then": {
        "required": [
          "looks"
        ]
      }
    },
    "outcome_rules": {
      "description": "풀이·채점 결과를 성공률에 어떻게 셀지. ①이 실행 결과를 남기고 ③이 이 규칙대로 셈",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_error",
        "timeout",
        "env_error",
        "grader_error",
        "undecidable",
        "out_of_scope",
        "env_error_reasons"
      ],
      "properties": {
        "agent_error": {
          "description": "후보 탓 오류",
          "const": "fail"
        },
        "timeout": {
          "const": "fail"
        },
        "env_error": {
          "description": "우리 환경 탓. max_env_retries 까지 다시 실행 후에도 오류면 분석 단위에서 뺌",
          "const": "retry_then_exclude"
        },
        "grader_error": {
          "const": "exclude"
        },
        "undecidable": {
          "const": "exclude"
        },
        "out_of_scope": {
          "description": "P-01 확정 (11/23, 기획서 1.3 5.4): 도구 범위 밖은 1차 성공률에서 실패로 셈. 범위 밖 비율과 공통 문항의 범위 안 성공률은 리포트 detail.in_scope 에 따로",
          "const": "fail"
        },
        "env_error_reasons": {
          "description": "env_error 로 볼 outcome_reason 목록 (필수 — 비면 ①이 환경 탓과 후보 탓을 가를 수 없음). 기본값 settings env_error_reasons. env_ 로 시작하는 값 + 팀이 정하면 llm_api_429",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "common.schema.json#/$defs/outcome_reason"
              },
              {
                "anyOf": [
                  {
                    "pattern": "^env_"
                  },
                  {
                    "const": "llm_api_429"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "max_env_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "process_policy": {
      "description": "과정 정책 (선택, 2026-11-26 과정 채점). 실행 전에 고정되며 잠근 뒤 바꾸면 다른 실험. 판정은 grading.eng_policy, 결과는 sa_policy_results. 칸이 없으면 정책 검사 안 함",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "approved_tools": {
          "description": "승인 목록. 칸이 없으면 승인 검사 안 함, [] 이면 외부 도구 호출을 모두 금지. 엔진 내장 도구는 항상 허용. 기능 이름표와 별개 (무엇을 하나 ≠ 어느 도구를 허용하나)",
          "type": "array",
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "server",
                  "tool"
                ],
                "properties": {
                  "source": {
                    "const": "mcp"
                  },
                  "server": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "tool": {
                    "description": "도구 이름 또는 * (그 서버 전부)",
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "description": "있으면 config_snapshot.mcp_servers[].version 과 정확히 같아야 함",
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "tool",
                  "def_hash"
                ],
                "properties": {
                  "source": {
                    "const": "custom"
                  },
                  "tool": {
                    "$ref": "common.schema.json#/$defs/tool_name"
                  },
                  "def_hash": {
                    "description": "서버 없는 자체 도구 정의(tool_def 전체)의 canonical_hash",
                    "$ref": "common.schema.json#/$defs/hash"
                  }
                }
              }
            ]
          }
        },
        "read_before_write": {
          "description": "쓰기 전에 같은 대상(서비스·대상 종류·저장소·대상 ID)을 정상 조회했어야 함. 대상 인자는 tool_def.target_args",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create_writes": {
              "description": "대상 ID 가 없는 생성 쓰기: skip 건너뜀(기본) / undecided 판정 불가",
              "enum": [
                "skip",
                "undecided"
              ]
            }
          }
        },
        "gate": {
          "description": "true 면 위반한 풀이는 성공일 수 없음. 기본 false (보고만)",
          "type": "boolean"
        }
      }
    }
  }
}
