      "tools": [
        {
          "name": "list_deployments",
          "capabilities": [
            "github.actions.read"
          ],
          "access": "read",
          "source_snapshot": "deployments",
          "source_key": "deployments",
          "input_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "output_schema": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "environment",
                "finished_at",
                "repo",
                "run_id",
                "status",
                "version"
              ],
              "properties": {
                "run_id": {
                  "type": [
                    "integer"
                  ]
                },
                "repo": {
                  "type": [
                    "string"
                  ]
                },
                "environment": {
                  "type": [
                    "string"
                  ]
                },
                "status": {
                  "type": [
                    "string"
                  ]
                },
                "finished_at": {
                  "type": [
                    "string"
                  ]
                },
                "version": {
                  "type": [
                    "string"
                  ]
                },
                "sha": {
                  "type": [
                    "string"
                  ]
                },
                "started_at": {
                  "type": [
                    "string"
                  ]
                }
              }
            }
          },
          "semantics": "모든 연습 저장소의 배포 실행 조회. deployments와 operations의 같은 전체 데이터 범위를 제공하며 실행 번호는 정수 run_id. sha·started_at은 원본에 있을 때만 포함. repo만 정확 일치 필터 지원하며 생략하면 전체. 상태·환경·라벨·날짜 필터와 정렬은 반환된 레코드에서 처리. 원본 순서 유지, 일치 기록 없으면 []. 원본에 없는 필드는 추정하지 않음."
        },
